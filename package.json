{
  "name": "rgg-inventory",
  "version": "0.4.1",
  "description": "Оверлей-инвентарь для RGG-стримеров: инвентарь 2+ полосы, таймер, темы и авто-разметка дизайна по картинке. Angular + Tauri.",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/sync-version.mjs && node scripts/sync-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/sync-version.mjs && node scripts/sync-env.mjs",
    "build": "ng build",
    "prewatch": "node scripts/sync-version.mjs && node scripts/sync-env.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/sync-version.mjs && node scripts/sync-env.mjs",
    "test": "ng test",
    "lint": "eslint .",
    "lint:css": "stylelint --config stylelintrc.json \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@ngrx/signals": "^21.1.1",
    "@taiga-ui/cdk": "^5.22.0",
    "@taiga-ui/core": "^5.22.0",
    "@taiga-ui/event-plugins": "^5.0.0",
    "@taiga-ui/i18n": "^5.22.0",
    "@taiga-ui/icons": "^5.22.0",
    "@taiga-ui/kit": "^5.22.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@taiga-ui/styles": "^5.22.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.5.8",
    "fflate": "^0.8.2",
    "less": "^4.9.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.2.0",
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/eslint-plugin-template": "^22.2.0",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@antfu/eslint-config": "^3.11.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@tauri-apps/cli": "^2.10.1",
    "eslint": "^9.17.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "stylelint": "^16.14.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
